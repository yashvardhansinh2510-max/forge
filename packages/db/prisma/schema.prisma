generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  clerkId          String?           @unique
  name             String
  email            String            @unique
  passwordHash     String?
  role             UserRole          @default(WORKER)
  maxDiscountPct   Float             @default(15.0)
  createdAt        DateTime          @default(now())
  approvalRequests ApprovalRequest[] @relation("RequestedBy")
  approvedRequests ApprovalRequest[] @relation("ReviewedBy")
  purchaseOrders   PurchaseOrder[]   @relation("CreatedPurchaseOrders")
  quotations       Quotation[]       @relation("CreatedBy")
  stageMovements   StageMovement[]   @relation("StageMovements")
  transfers        Transfer[]        @relation("Transfers")
  ownedContacts    Contact[]         @relation("OwnedContacts")
}

model Contact {
  id             String      @id @default(cuid())
  name           String
  title          String
  companyId      String?
  email          String?
  phone          String?
  type           ContactType @default(ARCHITECT)
  tags           String[]
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  whatsapp       String?
  city           String?
  area           String?
  ownerId        String?
  lastActivityAt DateTime?
  notes          String?
  company        Company?    @relation(fields: [companyId], references: [id])
  owner          User?       @relation("OwnedContacts", fields: [ownerId], references: [id])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  industry  String
  website   String?
  address   String?
  createdAt DateTime  @default(now())
  contacts  Contact[]
  projects  Project[]
}

model Project {
  id             String          @id @default(cuid())
  clientName     String
  clientPhone    String?
  clientEmail    String?
  siteAddress    String?
  architectName  String?
  plumberName    String?
  companyId      String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryBoxes InventoryBox[]
  company        Company?        @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]
  quotations     Quotation[]
}

model Quotation {
  id            String              @id @default(cuid())
  number        String              @unique
  projectId     String?
  createdById   String
  currentStatus RevisionStatus      @default(DRAFT)
  createdAt     DateTime            @default(now())
  customerName   String?
  siteAddress    String?
  customerGST    String?
  billingAddress String?
  salesRep       String?
  brandLabel     String?
  createdBy      User                @relation("CreatedBy", fields: [createdById], references: [id])
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions     QuotationRevision[]

  @@index([currentStatus])
}

model QuotationRevision {
  id                String            @id @default(cuid())
  quotationId       String
  revisionNumber    Int               @default(0)
  status            RevisionStatus    @default(DRAFT)
  globalDiscountPct Float             @default(0.0)
  isLocked          Boolean           @default(false)
  lockedAt          DateTime?
  snapshot          Json?
  notes             String?
  customerPhone     String?
  validDays         Int               @default(30)
  validUntil        DateTime?
  termsAndConditions String?
  createdAt         DateTime          @default(now())
  approvalRequests  ApprovalRequest[]
  purchaseOrders    PurchaseOrder[]
  quotation         Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rooms             QuotationRoom[]

  @@unique([quotationId, revisionNumber])
}

model QuotationRoom {
  id         String            @id @default(cuid())
  revisionId String
  roomName   String
  order      Int               @default(0)
  items      QuotationItem[]
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
}

model QuotationItem {
  id                String          @id @default(cuid())
  roomId            String
  productId         String?
  isCustom          Boolean         @default(false)
  customDescription String?
  customBrand       String?
  customUnit        String?
  customHsnCode     String?
  customNotes       String?
  quantity          Int             @default(1)
  selectedFinish    String?
  selectedColor     String?
  mrp               Float
  discountPct       Float           @default(0.0)
  offerRate         Float
  totalOffer        Float
  isAutoAdded       Boolean         @default(false)
  sortOrder         Int             @default(0)
  stockOrdered      Int             @default(0)
  stockInBox        Int             @default(0)
  stockDispatched   Int             @default(0)
  inventoryStatus   InventoryStatus @default(QUOTED)
  imageUrl          String?
  finishName        String?
  seriesName        String?
  articleNumber     String?
  createdAt         DateTime        @default(now())
  boxItems          BoxItem[]
  poLineItems       POLineItem[]
  product           Product?        @relation(fields: [productId], references: [id])
  room              QuotationRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Product {
  id              String          @id @default(cuid())
  brand           ProductBrand
  category        ProductCategory
  sku             String          @unique
  name            String
  description     String?
  mrp             Float
  gstRate         Float           @default(18)
  unit            String          @default("pcs")
  imageUrl        String?
  tier            String          @default("premium")
  isActive        Boolean         @default(true)
  stockAvailable  Int             @default(0)
  variants        Json?
  concealedPartId String?
  stockOnOrder    Int             @default(0)
  stockCommitted  Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  articleNumber   String?
  brandGroup      String          @default("HANSGROHE")
  finishCode      String?
  finishName      String?
  sectionName     String?
  seriesName      String?
  sourceFile      String?
  subcategory     String?
  hsnCode         String?
  filterTags      String[]        @default([])
  sortOrder       Int?
  boxItems        BoxItem[]
  poLineItems     POLineItem[]
  concealedPart   Product?        @relation("ConcealedParts", fields: [concealedPartId], references: [id])
  requiredBy      Product[]       @relation("ConcealedParts")
  quotationItems  QuotationItem[]
  stockItems      StockItem[]
  movements       StockMovement[]

  @@index([articleNumber])
}

model ApprovalRequest {
  id            String            @id @default(cuid())
  revisionId    String
  requestedById String
  requestedPct  Float
  reviewedById  String?
  status        ApprovalStatus    @default(PENDING)
  note          String?
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  requestedBy   User              @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  revision      QuotationRevision @relation(fields: [revisionId], references: [id])
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String
  shortName   String
  type        WarehouseType
  address     String
  city        String
  state       String          @default("Maharashtra")
  managerName String
  phone       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  stockItems  StockItem[]
  movements   StockMovement[]
}

model StockItem {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model StockMovement {
  id              String       @id @default(cuid())
  type            MovementType
  productId       String
  fromWarehouseId String?
  toWarehouseId   String?
  quantity        Int
  reference       String
  reason          String?
  performedByName String
  createdAt       DateTime     @default(now())
  fromWarehouse   Warehouse?   @relation(fields: [fromWarehouseId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id                  String             @id @default(cuid())
  poNumber            String             @unique
  mode                POMode
  status              POStatus           @default(DRAFT)
  projectId           String?
  revisionId          String?
  createdById         String
  vendorName          String?
  expectedDelivery    DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  customerName        String?
  customerSiteAddress String?
  quotationNumber     String?
  inventoryBoxes      InventoryBox[]
  lineItems           POLineItem[]
  createdBy           User               @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  project             Project?           @relation(fields: [projectId], references: [id])
  revision            QuotationRevision? @relation(fields: [revisionId], references: [id])

  @@index([status])
}

model POLineItem {
  id              String          @id @default(cuid())
  poId            String
  productId       String
  quotationItemId String?
  qtyOrdered      Int
  qtyReceived     Int             @default(0)
  qtyPendingCo    Int             @default(0)
  qtyAtGodown     Int             @default(0)
  qtyInBox        Int             @default(0)
  qtyDispatched   Int             @default(0)
  landingCost     Float?
  clientOfferRate Float?
  status          POLineStatus    @default(PENDING)
  createdAt       DateTime        @default(now())
  followUpStatus  String?         @default("AWAITING")
  po              PurchaseOrder   @relation(fields: [poId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  quotationItem   QuotationItem?  @relation(fields: [quotationItemId], references: [id])
  stageMovements  StageMovement[]
  purchaseItems   PurchaseItem[]
  transfers       Transfer[]
}

model StageMovement {
  id           String     @id @default(cuid())
  poLineItemId String
  fromStage    String
  toStage      String
  qty          Int
  movedById    String
  note         String?
  movedAt      DateTime   @default(now())
  movedBy      User       @relation("StageMovements", fields: [movedById], references: [id])
  poLineItem   POLineItem @relation(fields: [poLineItemId], references: [id])
}

model Transfer {
  id               String     @id @default(cuid())
  poLineItemId     String
  productId        String
  productName      String     @default("")
  fromCustomerId   String
  fromCustomerName String
  toCustomerId     String
  toCustomerName   String
  qty              Int
  stage            String
  notes            String?
  transferredById  String
  transferredAt    DateTime   @default(now())
  poLineItem       POLineItem @relation(fields: [poLineItemId], references: [id])
  transferredBy    User       @relation("Transfers", fields: [transferredById], references: [id])

  @@index([fromCustomerId])
  @@index([toCustomerId])
  @@index([poLineItemId])
}

model InventoryBox {
  id        String         @id @default(cuid())
  boxCode   String         @unique
  projectId String
  poId      String?
  createdAt DateTime       @default(now())
  items     BoxItem[]
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  project   Project        @relation(fields: [projectId], references: [id])
}

model BoxItem {
  id              String         @id @default(cuid())
  boxId           String
  productId       String
  quotationItemId String?
  qtyTotal        Int
  qtyDispatched   Int            @default(0)
  status          BoxItemStatus  @default(STAGED)
  lastUpdated     DateTime       @updatedAt
  box             InventoryBox   @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  quotationItem   QuotationItem? @relation(fields: [quotationItemId], references: [id])
}

model SalesOrder {
  id              String            @id @default(cuid())
  number          String            @unique
  customerId      String
  customerName    String
  customerPhone   String?
  status          SalesOrderStatus  @default(CONFIRMED)
  projectName     String?
  deliveryAddress String?
  notes           String?
  mrpTotal        Float             @default(0)
  offerTotal      Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  payments        CustomerPayment[]
  lineItems       SalesOrderLine[]
}

model SalesOrderLine {
  id        String     @id @default(cuid())
  orderId   String
  sku       String
  name      String
  brand     String     @default("")
  qty       Int
  mrp       Float
  offerRate Float
  createdAt DateTime   @default(now())
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CustomerPayment {
  id         String                @id @default(cuid())
  orderId    String
  amount     Float
  method     CustomerPaymentMethod @default(CASH)
  reference  String?
  notes      String?
  receivedAt DateTime
  recordedBy String                @default("System")
  createdAt  DateTime              @default(now())
  order      SalesOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
}

model FollowUp {
  id               String               @id @default(cuid())
  type             FollowUpType         @default(WALK_IN)
  customerName     String
  customerPhone    String
  customerType     FollowUpCustomerType @default(RETAIL)
  brandsInterested String[]
  productsNoted    String?
  estimatedBudget  Float?
  projectName      String?
  quotationId      String?
  quotationNumber  String?
  quotationValue   Float?
  status           FollowUpStatus       @default(PENDING)
  nextFollowUpDate DateTime
  lastContactedAt  DateTime?
  notes            String?
  assignedTo       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  responses        FollowUpResponse[]

  @@index([status, nextFollowUpDate])
  @@index([customerPhone])
}

model FollowUpResponse {
  id          String                 @id @default(cuid())
  followUpId  String
  date        DateTime
  method      FollowUpResponseMethod @default(CALL)
  outcome     String
  nextAction  String?
  staffMember String
  createdAt   DateTime               @default(now())
  followUp    FollowUp               @relation(fields: [followUpId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  userId      String?
  contactId   String?
  companyId   String?
  projectId   String?
  quotationId String?
  value       Float?
  createdAt   DateTime     @default(now())

  @@index([contactId])
}

enum UserRole {
  OWNER
  MANAGER
  WORKER
}

enum RevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  LOCKED
  FINALIZED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryStatus {
  QUOTED
  IN_BOX
  PARTIALLY_DISPATCHED
  FULLY_DISPATCHED
}

enum ProductBrand {
  GROHE
  HANSGROHE
  AXOR
  VITRA
  GEBERIT
  OTHER
}

enum ProductCategory {
  SHOWERS
  WCS
  THERMOSTATS
  FAUCETS
  BASINS
  BATHTUBS
  ACCESSORIES
  CONCEALED
  KITCHEN
}

enum ContactType {
  ARCHITECT
  INTERIOR_DESIGNER
  BUILDER
  CONTRACTOR
  RETAIL
  INSTITUTIONAL
}

enum WarehouseType {
  SHOWROOM
  GODOWN
  DISPATCH
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUST
  RETURN
}

enum POStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum POMode {
  PROJECT_LINKED
  BULK_COMPANY
}

enum POLineStatus {
  PENDING
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum BoxItemStatus {
  STAGED
  PARTIALLY_DISPATCHED
  FULLY_DISPATCHED
}

enum SalesOrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum CustomerPaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
}

enum FollowUpType {
  WALK_IN
  QUOTATION
  QUOTATION_FOLLOWUP
}

enum FollowUpStatus {
  PENDING
  CONTACTED
  INTERESTED
  NEGOTIATING
  WON
  LOST
}

enum FollowUpCustomerType {
  ARCHITECT
  INTERIOR_DESIGNER
  BUILDER
  RETAIL
  OTHER
}

enum FollowUpResponseMethod {
  CALL
  WHATSAPP
  EMAIL
  VISIT
}

model PurchaseItem {
  id             String             @id @default(cuid())
  orderId        String
  productId      String
  batchQty       Int
  status         PurchaseItemStatus @default(NEEDS_PO)
  supplierId     String?
  receivedAt     DateTime?
  dispatchedAt   DateTime?
  godownLocation String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  order          POLineItem         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

enum PurchaseItemStatus {
  NEEDS_PO
  ORDERED
  AT_GODOWN
  IN_BOX
  DISPATCHED
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SITE_VISIT
  SHOWROOM_VISIT
  NOTE
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_APPROVED
}
